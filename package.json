{
  "name": "dream-commerce",
  "private": true,
  "version": "1.0.0",
  "description": "Production multi-vendor e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @dream/backend",
    "dev:admin": "npm run dev -w @dream/admin-web",
    "dev:customer": "npm run dev -w @dream/customer-web",
    "dev:mobile": "npm run start:clear -w @dream/mobile",
    "dev:delivery": "npm run start:clear -w @dream/delivery",
    "dev:vendor": "npm run start:clear -w @dream/vendor",
    "seed": "npm run seed -w @dream/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-linking": "57.0.10",
    "expo-location": "57.0.17",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "babel-preset-expo": "57.0.11",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  }
}
