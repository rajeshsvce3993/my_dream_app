{
  "expo": {
    "name": "Dream Delivery",
    "slug": "dream-delivery",
    "scheme": "dreamdelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F2430",
    "splash": {
      "backgroundColor": "#0F2430",
      "resizeMode": "contain"
    },
    "android": {
      "backgroundColor": "#0F2430",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "ios": {
      "backgroundColor": "#0F2430",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dream Delivery uses your location when you go online so orders in your service area can be offered to you."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dream Delivery uses your location when you go online so orders in your service area can be offered to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
