# Recommended for Expo Go on your phone — same IP as Metro (exp://YOUR_IP:8081)
EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1

# Android Studio emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Or: npm run adb:reverse  then EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1

# Loopback + auto (dev only):
# EXPO_PUBLIC_API_HOST=127.0.0.1
# EXPO_PUBLIC_API_PORT=4000
# EXPO_PUBLIC_API_PREFIX=/api/v1
# EXPO_PUBLIC_API_AUTO_HOST=true
# EXPO_PUBLIC_API_LAN_HOST=192.168.0.10
