NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017/dream_commerce
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

PAYMENT_PROVIDER=cod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

LOG_LEVEL=info

# --- OTP (development) — defaults; overridden by admin DB key otp.settings when seeded ---
OTP_PROVIDER=mock
TEST_OTP=1234
OTP_LENGTH=4
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- OTP (production — use MSG91, never mock) ---
# NODE_ENV=production
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
